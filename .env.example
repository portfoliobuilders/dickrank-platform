DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dickrank-content
# Optional. When set, uploads use SSE-KMS. Otherwise SSE-S3 (AES256) is required.
AWS_S3_KMS_KEY_ID=
CLOUDFRONT_DOMAIN=

# Shared secret for the internal moderation webhook. Generate a long random value.
MODERATION_WEBHOOK_SECRET=
AWS_REKOGNITION_SNS_TOPIC_ARN=
AWS_REKOGNITION_ROLE_ARN=

# ClamAV clamd. Leave host empty until the scanner is deployed.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Set to true in production so uploads fail closed when ClamAV is not reachable.
CLAMAV_ENFORCE=false
