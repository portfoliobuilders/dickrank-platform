DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dickrank
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/dickrank

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use a restricted Stripe key (rk_) with only the permissions this app needs:
# Customers, Checkout Sessions, PaymentIntents, Products, Prices, Subscriptions,
# Invoices, Transfers, Payouts, Account Sessions, and Accounts v2.
# Store the key in your host's secrets vault (on Vercel, a sensitive env var).
# Never commit live or test keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# 32+ character secret used to encrypt email and phone at rest.
ENCRYPTION_KEY=
# Optional 32-byte base64 key. Used when ENCRYPTION_KEY is unset.
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=
# Long random string used only for one-way IP and email hashes
IP_HASH_SALT=

# Platform fee in basis points. 2000 = 20%.
PLATFORM_FEE_BPS=2000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. When unset, exports and deletion still remove database PII,
# but media deletion fails closed if a file key exists.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SEARCH_INDEX_URL=
SEARCH_INDEX_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=DickRank <noreply@dickrank.online>

# Bearer token for the daily retention job
CRON_SECRET=

# Local only. Never enable in production.
ALLOW_DEV_AUTH=false

# Local UI preview only. Shows sample creator "preview" without a database.
PAYMENTS_UI_PREVIEW=false
