# DickRank production environment
# Copy to .env.local for local development. Never commit real values.
# In Vercel, set each name below in Project Settings → Environment Variables.
# Server-only secrets must be scoped to Production/Preview, not exposed as NEXT_PUBLIC_.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=production
# Public site origin. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL=https://dickrank.online
NEXT_PUBLIC_APP_NAME=DickRank

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# Use the pooler URL for the app (port 6543) and the direct URL for migrations
# and pg_dump (port 5432). DATABASE_SSL=require in production.
# Local docker-compose:
#   DATABASE_URL=postgresql://dickrank:dickrank_dev_only@localhost:5432/dickrank
#   DATABASE_SSL=disable
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_SSL=require

# -----------------------------------------------------------------------------
# Supabase
# NEXT_PUBLIC_ keys are visible in the browser. The service role key bypasses
# row level security and must stay on the server.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Stripe
# Secret and webhook keys are server-only. The publishable key is public.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# -----------------------------------------------------------------------------
# AWS (S3 media, CloudFront, backups)
# Leave S3_ENDPOINT empty in production. For local MinIO (docker-compose):
#   S3_ENDPOINT=http://localhost:9000
#   AWS_ACCESS_KEY_ID=dickrank
#   AWS_SECRET_ACCESS_KEY=dickrank_dev_only
#   AWS_S3_BUCKET=dickrank-media
#   AWS_S3_BACKUP_BUCKET=dickrank-backups
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional. When set, backups use SSE-KMS. Otherwise they use SSE-S3 (AES256).
AWS_KMS_KEY_ID=
AWS_S3_BUCKET=dickrank-media
AWS_S3_BACKUP_BUCKET=dickrank-backups
# Hostname only, no path. Used by next/image. Example: d111111abcdef8.cloudfront.net
CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Secrets
# Generate each with: openssl rand -base64 32
# JWT_SECRET signs session tokens. ENCRYPTION_KEY encrypts PII at rest
# (id documents, verification data, email, phone). Both are server-only.
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Redis (optional cache). Local docker-compose: redis://localhost:6379
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Ops script retention
# -----------------------------------------------------------------------------
# Database dumps older than this many days are deleted after a successful backup.
BACKUP_RETENTION_DAYS=30
# temp/ and uploads/tmp/ objects older than this are treated as orphaned.
ORPHAN_OBJECT_MAX_AGE_HOURS=24
# Local temp directory cleaned by scripts/cleanup-temp.ts.
TEMP_DIR=
TEMP_FILE_MAX_AGE_HOURS=24
# Audit rows older than this are copied to S3, then removed from the database.
AUDIT_LOG_ARCHIVE_DAYS=90
