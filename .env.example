# Local UI without Supabase. Remove this line in production.
DATA_BACKEND=memory

# Required whenever preferences are saved. Use a long random secret.
ENCRYPTION_KEY=

# Production data (Supabase). All three are required together.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only used if you run Prisma against Postgres.
DATABASE_URL=
