# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# At least 32 characters. Used to encrypt profile preferences at rest.
ENCRYPTION_KEY=replace-with-a-long-random-string

# Local UI preview only. Ignored when Supabase is configured or NODE_ENV=production.
DEMO_CONTENT=false
