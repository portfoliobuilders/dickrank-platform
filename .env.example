# Postgres (Supabase connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dickrank"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dickrank"

# Supabase auth — used to confirm who is signed in
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Leaderboard cache. Rankings are stored for 15 minutes.
REDIS_URL="redis://localhost:6379"

# Daily ranking job. Vercel Cron sends this as a bearer token.
CRON_SECRET="replace-with-a-long-random-string"
