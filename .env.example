# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dickrank"
DIRECT_URL="postgresql://user:password@localhost:5432/dickrank"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-characters-long"

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS S3
# Uploads and image loading read AWS_S3_BUCKET and AWS_CLOUDFRONT_DOMAIN.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="dickrank-content"
S3_BUCKET_NAME="dickrank-content"
AWS_CLOUDFRONT_DOMAIN="cdn.dickrank.online"
CLOUDFRONT_DOMAIN="cdn.dickrank.online"

# Stripe
# Use a restricted key (rk_) with only the permissions this app needs:
# Customers, Checkout Sessions, PaymentIntents, Products, Prices, Subscriptions,
# Invoices, Transfers, Payouts, Account Sessions, and Accounts v2.
# Store the key in your host's secrets vault. Never commit live or test keys.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend Email
RESEND_API_KEY="re_..."
EMAIL_FROM="DickRank <noreply@dickrank.online>"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="sntrys_..."

# Mixpanel
# Optional. Events log to the console in development when this is empty.
NEXT_PUBLIC_MIXPANEL_TOKEN="..."

# Cron Secret
CRON_SECRET="your-cron-secret-key"

# Security
IP_SALT="random-salt-for-ip-hashing"
ENCRYPTION_KEY="32-char-key-for-encryption"
AGE_COOKIE_SECRET="long-random-secret-for-the-age-gate-cookie"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Platform fee in basis points. 2000 = 20%.
PLATFORM_FEE_BPS=2000
# Local UI preview only. Shows sample creator "preview" without a database.
PAYMENTS_UI_PREVIEW=false

# S3 media storage (image processing uploads WebP originals + thumbnails).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional local MinIO / custom endpoint (disables SSE-S3 header).
AWS_S3_ENDPOINT=
# Optional CDN host for public media URLs (no https://).
CLOUDFRONT_DOMAIN=
