# Local preview without Supabase. Do not set this in production.
DATA_BACKEND=memory

# Required to encrypt profile preferences and notification email.
# Use at least 32 random characters.
ENCRYPTION_KEY=

# Production (Supabase). All three are required together.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used when running Prisma against Postgres.
DATABASE_URL=
