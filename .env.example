# Use a restricted Stripe key (rk_) with only the permissions this app needs:
# Customers, Checkout Sessions, PaymentIntents, Products, Prices, Subscriptions,
# Invoices, Transfers, Payouts, Account Sessions, and Accounts v2.
# Store the key in your host's secrets vault (on Vercel, a sensitive env var).
# Never commit live or test keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ character secret used to encrypt email and phone at rest.
ENCRYPTION_KEY=

# Platform fee in basis points. 2000 = 20%.
PLATFORM_FEE_BPS=2000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Resend sends subscription, tip, welcome, and reset emails when set.
RESEND_API_KEY=
EMAIL_FROM=DickRank <noreply@dickrank.online>

# Required for /api/cron/email-queue and other scheduled jobs.
CRON_SECRET=

# Local UI preview only. Shows sample creator "preview" without a database.
PAYMENTS_UI_PREVIEW=false
