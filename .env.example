# Local SQLite file used by Prisma. Production should point at Supabase Postgres.
DATABASE_URL="file:./dev.db"

# Required. Use a long random value in production.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Encrypts email addresses and government-ID storage references at rest.
AUTH_ENCRYPTION_KEY="replace-with-a-long-random-string"

# Optional HTTPS webhook that receives verification emails as JSON.
# When unset in development, codes are written to storage/dev-mailbox (gitignored).
# Production refuses to create a code delivery without this webhook.
# EMAIL_WEBHOOK_URL="https://example.com/email"
# EMAIL_FROM="noreply@dickrank.online"
