DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dickrank
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=
# Long random string used only for one-way IP and email hashes
IP_HASH_SALT=

# Optional. When unset, exports and deletion still remove database PII,
# but media deletion fails closed if a file key exists.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

STRIPE_SECRET_KEY=
SEARCH_INDEX_URL=
SEARCH_INDEX_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=DickRank <noreply@dickrank.online>

# Bearer token for the daily retention job
CRON_SECRET=

# Local only. Never enable in production.
ALLOW_DEV_AUTH=false
