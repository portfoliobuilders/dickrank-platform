# DickRank environment template.
# Copy to .env.local for local development. Never commit real secrets.
# On Vercel, set the same names in Project Settings → Environment Variables
# for Production, Preview, and Development. vercel.json only bakes public,
# non-secret values.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
# Production: https://dickrank.online
# Preview on Vercel: https://$VERCEL_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# Local values match docker-compose.yml (development only).
# Supabase: use the direct connection (port 5432) for DIRECT_URL.
# The pooled connection (port 6543) can stay in DATABASE_URL for the app.
# pg_dump refuses to run through the pooler, so backups read DIRECT_URL first.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://dickrank:dickrank@127.0.0.1:5432/dickrank
DIRECT_URL=postgresql://dickrank:dickrank@127.0.0.1:5432/dickrank
# Set to false only if a hosted Postgres certificate cannot be verified.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Publishable key is safe to expose. Secret and webhook signing secret are not.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AWS (S3 backups, media, CloudFront)
# Leave AWS_S3_ENDPOINT empty in production. For local MinIO:
#   AWS_S3_ENDPOINT=http://127.0.0.1:9000
#   AWS_ACCESS_KEY_ID=minio
#   AWS_SECRET_ACCESS_KEY=minioadmin
#   AWS_S3_BUCKET=dickrank-local
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
# Hostname only, for example d111111abcdef8.cloudfront.net
AWS_CLOUDFRONT_DOMAIN=

# -----------------------------------------------------------------------------
# Secrets
# Generate with:
#   openssl rand -base64 48    # JWT_SECRET
#   openssl rand -base64 32    # ENCRYPTION_KEY (must decode to 32 bytes)
# ENCRYPTION_KEY encrypts database backups, archived audit logs, and PII at rest.
# -----------------------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Redis (local cache; docker-compose.yml)
# Production Redis must require a password. Do not use this URL in production.
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Maintenance scripts (scripts/backup-db.ts, scripts/cleanup-temp.ts)
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
TEMP_DIR=./tmp
TEMP_FILE_MAX_AGE_HOURS=24
TEMP_OBJECT_MAX_AGE_HOURS=24
ORPHAN_MIN_AGE_HOURS=48
# Safety switch. Leave unset unless media_objects is intentionally empty.
CLEANUP_ALLOW_EMPTY_MEDIA_INDEX=
