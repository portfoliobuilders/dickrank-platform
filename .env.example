# Use a restricted Stripe key (rk_) with only the permissions this app needs:
# Customers, Checkout Sessions, PaymentIntents, Products, Prices, Subscriptions,
# Invoices, Transfers, Payouts, Account Sessions, and Accounts v2.
# Store the key in your host's secrets vault (on Vercel, a sensitive env var).
# Never commit live or test keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ character secret used to encrypt email and phone at rest.
ENCRYPTION_KEY=

# Platform fee in basis points. 2000 = 20%.
PLATFORM_FEE_BPS=2000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Error and performance reporting. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Resend sends subscription and tip emails when set.
RESEND_API_KEY=
EMAIL_FROM=DickRank <noreply@dickrank.online>

# Local UI preview only. Shows sample creator "preview" without a database.
PAYMENTS_UI_PREVIEW=false

# S3 media storage (image processing uploads WebP originals + thumbnails).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional local MinIO / custom endpoint (disables SSE-S3 header).
AWS_S3_ENDPOINT=
# Optional CDN host for public media URLs (no https://).
CLOUDFRONT_DOMAIN=
