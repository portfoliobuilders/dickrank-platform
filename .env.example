# PostgreSQL connection used by Prisma. Supabase: Project Settings → Database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dickrank?schema=public"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY="replace-with-base64-32-bytes"
# Separate secret for email/phone/IP lookup hashes. Generate with: openssl rand -base64 32
PII_HASH_PEPPER="replace-with-a-long-random-string"
# Signs the NextAuth session cookie. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Signs the age-verification cookie. Generate with: openssl rand -base64 32
AGE_COOKIE_SECRET="replace-with-a-long-random-string"

# Supabase Auth. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="content"

# Stripe payments. Webhook endpoint: https://your-domain/webhooks/stripe
STRIPE_SECRET_KEY="sk_test_replace"
STRIPE_WEBHOOK_SECRET="whsec_replace"

# Local development only. Production should run ClamAV and set this to false.
# true = accept files that pass type and signature checks when ClamAV is offline.
VIRUS_SCAN_ALLOW_HEURISTIC="true"
CLAMAV_HOST=""
CLAMAV_PORT="3310"
