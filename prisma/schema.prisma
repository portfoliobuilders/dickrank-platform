generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CREATOR
  MODERATOR
  ADMIN

  @@map("user_role")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED

  @@map("scan_status")
}

enum Visibility {
  PUBLIC
  SUBSCRIBERS
  PRIVATE

  @@map("content_visibility")
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID

  @@map("subscription_status")
}

enum EventKind {
  COMPETITION
  PARTY

  @@map("event_kind")
}

enum ReviewState {
  PENDING
  APPROVED
  REJECTED

  @@map("review_state")
}

/// Account row. Email, phone, date of birth, and ID references are encrypted before they are stored.
model User {
  id                   String             @id @default(cuid())
  supabaseId           String?            @unique @map("supabase_id")
  username             String             @unique
  passwordHash         String             @map("password_hash")
  emailEncrypted       String             @map("email_encrypted")
  emailHash            String             @unique @map("email_hash")
  emailVerifiedAt      DateTime?          @map("email_verified_at")
  emailCodeHash        String?            @map("email_code_hash")
  emailCodeExpires     DateTime?          @map("email_code_expires")
  resetTokenHash       String?            @map("reset_token_hash")
  resetTokenExpires    DateTime?          @map("reset_token_expires")
  phoneEncrypted       String?            @map("phone_encrypted")
  role                 Role               @default(USER)
  ageVerification      Boolean            @default(false) @map("age_verification")
  ageVerifiedAt        DateTime?          @map("age_verified_at")
  dateOfBirthEncrypted String?            @map("date_of_birth_encrypted")
  idDocumentEncrypted  String?            @map("id_document_encrypted")
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  profile              Profile?
  contents             Content[]
  ratings              Rating[]
  subscriptions        Subscription[] @relation("SubscriberSubscriptions")
  creatorSubscriptions Subscription[] @relation("CreatorSubscriptions")
  eventsHosted         Event[]
  eventRsvps           EventRsvp[]
  auditLogs            AuditLog[]
  reviewItems          ReviewQueue[]

  @@index([role])
  @@index([ageVerification])
  @@index([verificationStatus])
  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  displayName String   @map("display_name")
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  bannerUrl   String?  @map("banner_url")
  location    String?
  website     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@map("profiles")
}

model Content {
  id           String     @id @default(cuid())
  creatorId    String     @map("creator_id")
  title        String
  description  String?
  mediaKey     String     @unique @map("media_key")
  mimeType     String     @map("mime_type")
  mediaType    MediaType  @map("media_type")
  byteSize     Int        @map("byte_size")
  scanStatus   ScanStatus @default(PENDING) @map("scan_status")
  scanDetails  String?    @map("scan_details")
  visibility   Visibility @default(SUBSCRIBERS)
  averageScore Float      @default(0) @map("average_score")
  ratingCount  Int        @default(0) @map("rating_count")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  creator User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  ratings Rating[]

  @@index([creatorId])
  @@index([createdAt])
  @@index([visibility, scanStatus, averageScore])
  @@index([ratingCount])
  @@map("contents")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  contentId String   @map("content_id")
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([score])
  @@index([createdAt])
  @@map("ratings")
}

model Subscription {
  id                   String             @id @default(cuid())
  subscriberId         String             @map("subscriber_id")
  creatorId            String             @map("creator_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  subscriber User @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    User @relation("CreatorSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, creatorId])
  @@index([creatorId])
  @@index([status])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

model Event {
  id          String    @id @default(cuid())
  hostId      String    @map("host_id")
  title       String
  description String?
  kind        EventKind
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  location    String?
  capacity    Int?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  host  User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  rsvps EventRsvp[]

  @@index([hostId])
  @@index([startsAt])
  @@index([kind])
  @@map("events")
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   String?
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Manual 18+ review. Uploading an ID queues a row; it does not grant access.
model ReviewQueue {
  id                     String      @id @default(cuid())
  userId                 String      @map("user_id")
  status                 ReviewState @default(PENDING)
  frontDocumentEncrypted String      @map("front_document_encrypted")
  backDocumentEncrypted  String      @map("back_document_encrypted")
  selfieEncrypted        String      @map("selfie_encrypted")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("review_queue")
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@map("stripe_events")
}
